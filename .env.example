# Local development only. Copy to .env at the repository root.
POSTGRES_PORT=55432
# Optional local database browser: http://localhost:8082
DB_UI_PORT=8082
POSTGRES_PASSWORD=resumatch_local_only
DATABASE_URL=postgresql+psycopg://resumatch:resumatch_local_only@127.0.0.1:55432/resumatch
# Tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://resumatch:resumatch_local_only@127.0.0.1:55432/resumatch_test
WEB_ORIGIN=http://localhost:3000
# Explicit alternate browser origins (JSON list); no wildcards or automatic port matching.
WEB_ADDITIONAL_ORIGINS=["http://127.0.0.1:3000"]
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# Used only by the Next.js server; never a NEXT_PUBLIC_ variable.
API_ORIGIN=http://127.0.0.1:8000
# Optional explicit review analysis; core logging and computed recaps work without a provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# daily.dev authorization is a future bounded read-only experiment; see personel-docs/resumatch/decisions/daily-dev.md.
